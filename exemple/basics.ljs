; LJSP Basics Example

; 1. Arithmetic
($console.log '--- Arithmetic ---')
($console.log '1 + 2 + 3 =' (+ 1 2 3))
($console.log '10 - 5 =' (- 10 5))
($console.log '2 * 3 * 4 =' (* 2 3 4))
($console.log '10 / 2 =' (/ 10 2))

; 2. Variables and Functions
($console.log '--- Variables and Functions ---')
(:const x 10)
(:const square (:fn (n) (* n n)))
($console.log 'x is' x)
($console.log 'square of x is' (square x))

; 3. Conditionals
($console.log '--- Conditionals ---')
(:const check-value (:fn (v) 
    (:if (> v 5) 
        'Greater than 5' 
        '5 or less')))

($console.log 'Check 10:' (check-value 10))
($console.log 'Check 3:' (check-value 3))

; 4. Lists
($console.log '--- Lists ---')
(:const fruits ['apple' 'banana' 'cherry'])
($console.log 'Fruits:' fruits)
($console.log 'First fruit:' (get fruits 0))
($console.log 'Total fruits:' (length fruits))

(:const more-fruits (push fruits 'date' 'elderberry'))
($console.log 'Added more fruits:' more-fruits)

; 5. Nulls and Booleans
($console.log '--- Nulls and Booleans ---')
($console.log 'True value:' @true)
($console.log 'False value:' @false)
($console.log 'Null value:' @null)
($console.log 'Type of @null:' (typeof @null))

; 6. Console methods
($console.log '--- Console methods ---')
($console.warn 'This is a warning!')
($console.info 'This is some info.')
($console.count 'counter')
($console.count 'counter')
($console.table [[1 2] [3 4]])
